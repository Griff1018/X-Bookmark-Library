{
  "manifest_version": 3,
  "name": "X Bookmark Library",
  "version": "0.0.1",
  "description": "Turn X bookmarks and likes into a searchable local library with filters, media recovery, and JSON backup.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "windows"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open X Bookmark Library"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
